{
  "name": "admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:e2e": "npm run db:e2e:reset && playwright test",
    "db:e2e:seed:ci": "tsx prisma/seed-e2e.ts",
    "db:e2e:seed": "dotenv -e .env.e2e -- tsx prisma/seed-e2e.ts",
    "db:e2e:reset": "dotenv -e .env.e2e -- prisma migrate reset --force && npm run db:e2e:seed",
    "test:e2e:ci": "playwright test"
    
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-table": "^9.1.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.0",
    "lucide-react": "^1.43.0",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
